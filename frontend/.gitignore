@'
# Secrets
**/.env
**/.env.*
!**/.env.example

# Python cache
**/__pycache__/
*.py[cod]
*.pyo
*.pyd

# Python virtual environments
**/venv/
**/.venv/
**/env/
**/ENV/

# Python testing
.pytest_cache/
.mypy_cache/

# Node.js
**/node_modules/
dist/
dist-ssr/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
'@ | Set-Content -Encoding utf8 .gitignore